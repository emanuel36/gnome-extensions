msgid "Grouping"
msgstr "Agrupamento"

# settings.json
msgid "Hidden tasks extension"
msgstr "Extensões de tarefas ocultas"

# settings.json
msgid "Hide if pattern is zero"
msgstr "Esconder se o padrão for zero"

# settings.json
msgid "Icon"
msgstr "Ícone"

# settings.json
msgid ""
"If the hidden extension is enabled, tasks containing 'h:1' will not be shown"
msgstr ""
"Se ocultar extensão estiver ativada, tarefas que contem 'h:1' não serão "
"mostradas"

# settings.json
msgid ""
"If the specified pattern is zero, the elements specified here will be hidden"
msgstr ""
"Se o padrão especificado for zero, os elementos aqui especificados serão "
"ocultados"

# settings.json
msgid "If this is true, an icon will be shown in the top bar"
msgstr "Se ativo, um ícone será apresentado na barra de topo"

# settings.json
msgid ""
"If this template evaluates to zero, the top bar element will be hidden. "
"Shortcuts still work."
msgstr ""
"Se este 'template' avaliar para zero, o elemento na barra de topo será "
"ocultado. Os atalhos de teclado continuarão a funcionar."

# settings.json
msgid "Info"
msgstr "Info"

# settings.json
msgid "Interface elements"
msgstr "Elementos da interface"

# settings.json
msgid "Keep as is (non-standard)"
msgstr "Manter como está (não é o padrão)"

# settings.json
msgid "Keep open menu after adding new task"
msgstr "Manter menu aberto após adicionar uma tarefa"

# settings.json
msgid "Keep with pri: prefix"
msgstr "Manter com pri: prefixo"

# settings.json
msgid ""
"Keeps open the tasks menu after a new task is added. The new task entry will "
"be focused."
msgstr ""
"Mantém o menu de tarefas aberto após a adição de uma tarefa. A entrada de "
"tarefa nova será focada."

# settings.json
msgid "Keyboard shortcut to open the task list"
msgstr "Atalho de teclado para abrir a lista de tarefas"

# settings.json
msgid "Level of debug information"
msgstr "Nível da informação de debug"

# settings.json
msgid "Location of the text file that contains completed (archived) tasks"
msgstr ""
"Localização do ficheiro de texto que contém as tarefas completas (arquivadas)"

# settings.json
msgid "Location of the text file that contains the tasks in todo.txt syntax"
msgstr ""
"Localização do ficheiro de texto que contém as tarefas em sintaxe todo.txt"

# settings.json
msgid "Location to insert new task"
msgstr "Local para inserir a nova tarefa"

# settings.json
msgid "Location to truncate long tasks"
msgstr "Localização do truncar de tarefas longas"

# settings.json
msgid "Mark as done or archive"
msgstr "Marcar como feito ou arquivo"

# settings.json
msgid "Maximum task width in pixels"
msgstr "Largura máxima da tarefa em píxeis"

# settings.json
msgid "Method to expand/contract truncated tasks"
msgstr "Método para expandir/contrair tarefas truncadas"

# settings.json
msgid "Middle"
msgstr "Meio"

# settings.json
msgid "No grouping"
msgstr "Não agrupar"

# settings.json
msgid "Nothing"
msgstr "Nada"

# settings.json
msgid ""
"Only show tasks with a given or higher priority. Leave empty to show all "
"tasks."
msgstr ""
"Apenas mostrar tarefas com uma prioridade dada ou maior. Deixe vazio para "
"mostrar todas as tarefas."

# settings.json
msgid "Only show tasks with a priority of or above"
msgstr "Mostrar apenas tarefas com uma prioridade ou superior"

# settings.json
msgid "Open task list"
msgstr "Abrir lista de tarefas"

msgid "Order elements by their priority"
msgstr "Ordenar os elementos por sua prioridade"

# settings.json
msgid "Pattern to match for zero"
msgstr "Padrão a corresponder para zero"

# settings.json
msgid "Priorities"
msgstr "Prioridades"

# settings.json
msgid "Priority markup"
msgstr "Marcação da prioridade"

# settings.json
msgid "Priority on task completion"
msgstr "Prioridade ao completar tarefa"

# settings.json
msgid "Projects"
msgstr "Projetos"

# settings.json
msgid "Put ungrouped tasks in separate group"
msgstr "Colocar tarefas desagrupadas em grupo separado"

# settings.json
msgid "Remove"
msgstr "Eliminar"

# settings.json
msgid "Same as task"
msgstr "Igual à tarefa"

# settings.json
msgid "Scroll up/down"
msgstr "Rolar para cima/para baixo"

# settings.json
msgid "Select location of done.txt file"
msgstr "Selecionar localização do ficheiro done.txt"

# settings.json
msgid "Select location of todo.txt file"
msgstr "Selecionar localização do ficheiro todo.txt"

# settings.json
msgid "Shortcuts"
msgstr "Atalhos"

# settings.json
msgid "Show 'open in text editor'"
msgstr "Mostrar 'abrir no editor de texto'"

# settings.json
msgid "Show 'open preferences'"
msgstr "Mostrar 'abrir preferências'"

# settings.json
msgid "Show change task priority buttons"
msgstr "Mostrar botões para alterar prioridade"

# settings.json
msgid "Show contexts"
msgstr "Mostrar contextos"

# settings.json
msgid "Show delete task button"
msgstr "Mostrar botão para eliminar tarefa"

# settings.json
msgid "Show done tasks"
msgstr "Mostrar tarefas realizadas"

# settings.json
msgid "Show done/archive task button"
msgstr "Mostrar botão para completar/arquivar tarefa"

# settings.json
msgid "Show edit task button"
msgstr "Mostrar botão para editar tarefa"

# settings.json
msgid "Show icon"
msgstr "Mostrar ícone"

# settings.json
msgid "Show new task entry"
msgstr "Mostrar campo de nova tarefa"

# settings.json
msgid "Show number of tasks in group"
msgstr "Mostrar número de tarefas por grupo"

# settings.json
msgid "Show projects"
msgstr "Mostrar projetos"

# settings.json
msgid "Start"
msgstr "Início"

# settings.json
msgid "Style priorities"
msgstr "Estilizar prioridades"

# settings.json
msgid "Styles"
msgstr "Estilos"

# settings.json
msgid "Tasks can be grouped together based on the selected property"
msgstr "Tarefas podem ser agrupadas baseadas na opção selecionada"

# settings.json
msgid ""
"Tasks that don't have the grouping priority can be put in a special "
"'ungrouped' group, or shown outside any groups"
msgstr ""
"Tarefas que não possuem grupo podem ser colocadas num grupo especial "
"'desagrupadas', ou apresentadas fora de todos os grupos"

# settings.json
msgid ""
"Tasks will be truncated to this width (specified in pixels) if truncating is "
"enabled."
msgstr ""
"Tarefas serão truncadas a esta largura (em píxeis) se a truncagem estiver "
"ativa."

# settings.json
msgid "Template string for display"
msgstr "String de 'template' para visualização"

# settings.json
msgid "Template that determines what is displayed in the top bar"
msgstr "'Template' que determina o que é apresentado na barra de topo"

# settings.json
msgid "Text"
msgstr "Texto"

# settings.json
msgid "The action that will initiate expansion and contraction of tasks"
msgstr "A ação que irá iniciar a expansão e contração das tarefas"

# settings.json
msgid "The location in the task text where the ellipsization will occur"
msgstr "A localização no texto da tarefa onde as reticências irão aparecer"

# settings.json
msgid "The number of tasks in a subgroup can be shown in the interface"
msgstr "O número de tarefas num sub-grupo pode ser mostrado na interface"

# settings.json
msgid "The way that tasks with different priorities are displayed"
msgstr "A forma como tarefas com prioridades diferentes são apresentadas"

# settings.json
msgid "This color will be used for URLs if 'Custom color' was selected above"
msgstr ""
"Esta cor será utilizada para os URLs se 'Cor personalizada' estiver "
"selecionada acima"

# settings.json
msgid "Todo.txt location"
msgstr "Localização do todo.txt"

# settings.json
msgid "Top Bar"
msgstr "Barra de topo"

# settings.json
msgid "Top of the file"
msgstr "Topo do ficheiro"

# settings.json
msgid "Truncate long tasks"
msgstr "Truncar tarefas longas"

# settings.json
msgid "Truncating"
msgstr "Truncagem"

# settings.json
msgid "URL Color"
msgstr "Cor do URL"

# settings.json
msgid "Warning"
msgstr "Aviso"

# settings.json
msgid ""
"What should be done with the priority of a task when that task is completed"
msgstr ""
"O que deve ser efetuado à prioridade de uma tarefa quando essa tarefa é "
"concluída"

# settings.json
msgid "What to do when a task is clicked"
msgstr "O que fazer quando uma tarefa é clicada"

# settings.json
msgid "When URLs are detected in a task, they will be displayed in this color"
msgstr ""
"Quando URLs são detetados numa tarefa, eles serão apresentados nesta cor"

# settings.json
msgid ""
"Where in the text-file the new task will be added. Also moves insert box to "
"the top of the interface."
msgstr ""
"Onde no ficheiro de texto a nova tarefa será adicionada. Também move a caixa "
"de inserção para a parte superior da interface."

# settings.json
msgid "Whether a button is shown to delete a task"
msgstr "Se um botão é apresentado para eliminar uma tarefa"

# settings.json
msgid "Whether a button is shown to edit a task"
msgstr "Se é apresentado um botão que permite a edição de tarefas"

# settings.json
msgid ""
"Whether a button is shown to mark active tasks as completed or to archive "
"completed tasks, if auto-archive is off."
msgstr ""
"Se um botão é apresentado para marcar tarefas ativas como completadas ou "
"para arquivar tarefas completadas, se o arquivamento automático estiver "
"desativado."

# settings.json
msgid "Whether a confirmation dialog is shown before deleting a task"
msgstr ""
"Se uma mensagem de confirmação é apresentada antes de eliminar uma tarefa"

# settings.json
msgid "Whether a creation date is automatically added to newly created tasks"
msgstr ""
"Se a data de criação é automaticamente adicionada a tarefas acabadas de criar"

# settings.json
msgid "Whether a menu element is shown to open the extension's preferences"
msgstr ""
"Se um elemento de menu é mostrado para abrir as preferências da extensão"

# settings.json
msgid ""
"Whether a menu element is shown to open the todo.txt file in the default "
"text editor"
msgstr ""
"Se um elemento de menu é apresentado para abrir o ficheiro todo.txt no "
"editor de texto pré-definido"

# settings.json
msgid ""
"Whether an entry field is shown to create new tasks (new tasks can also be "
"added by modifying the todo.txt file)"
msgstr ""
"Se um campo de texto é apresentado na interface para permitir a criação de "
"novas tarefas (novas tarefas também podem ser adicionadas modificando o "
"ficheiro todo.txt)"

# settings.json
msgid "Whether arrows are shown to increase or decrease the task priority"
msgstr ""
"Se setas que permitem incrementar ou decrementar a prioridade de uma tarefa "
"são apresentadas"

# settings.json
msgid "Whether completed tasks that are not archived will be shown"
msgstr "Se as tarefas concluídas que não estão arquivadas serão mostradas"

# settings.json
msgid ""
"Whether completed tasks will be automatically archived (i.e. moved to the "
"done.txt file)"
msgstr ""
"Se tarefas completadas são arquivadas automaticamente (ou seja, movidas para "
"o ficheiro done.txt)"

# settings.json
msgid "Whether contexts are shown in the interface (does not affect grouping)"
msgstr ""
"Se os contextos são apresentados na interface (agrupamento não afetado)"

# settings.json
msgid "Whether long tasks are truncated if they exceed a specified width"
msgstr "Se tarefas longas são truncadas ao excederem uma largura especificada"

# settings.json
msgid "Whether projects are shown in the interface (does not affect grouping)"
msgstr "Se os projetos são apresentados na interface (agrupamento não afetado)"

# settings.json
msgid "Whether tasks with a certain priority are shown in a specific style"
msgstr ""
"Se tarefas com uma certa prioridade são apresentadas com um estilo "
"especificado"

# settings.json
msgid ""
"Whether the tasks with a higher priority should be shown higher up in the "
"list or the order should be left as in the todo.txt file"
msgstr ""
"Se as tarefas com maior prioridade devem ser mostradas mais acima na lista "
"ou a ordem deve ser deixada como no ficheiro todo.txt"

