#: ../libs/errors.js:28
msgid "%(file) cannot be written. Please check its permissions."
msgstr "%(file) nelze zapsat. Zkontrolujte prosím jeho oprávnění."

#: ../libs/todoTxtManager.js:524
msgid "%(file) exists already"
msgstr "%(file) již existuje"

#: ../libs/openTextEditorEntry.js:23
msgid ""
"An error occured while trying to launch the default text editor: %(error)"
msgstr ""
"Při pokusu o spuštění výchozího textového editoru došlo k chybě: %(error)"

#: ../libs/errors.js:37
msgid "An error occured while writing to %(file): %(error)"
msgstr "Při zápisu do %(file) došlo k chybě: %(error)"

#: ../libs/todoMenuItem.js:258
msgid "Archive %(task)"
msgstr "Archivovat %(task)"

#: ../libs/todoMenuItem.js:511
msgid "Are you sure?"
msgstr "Jsi si jistý?"

#: ../libs/todoTxtManager.js:521
msgid "Cancel"
msgstr "Zrušit"

#: ../libs/openTextEditorEntry.js:21
msgid "Cannot open file"
msgstr "Nelze otevřít soubor"

#: ../libs/todoTxtManager.js:511
msgid "Create new file"
msgstr "Vytvořit nový soubor"

#: ../libs/todoTxtManager.js:550
msgid "Create todo.txt and done.txt file in %(path)"
msgstr "Vytvořit soubor todo.txt a done.txt v %(path)"

#: ../libs/todoMenuItem.js:243
msgid "Decrease %(task) priority"
msgstr "Snížit prioritu %(task)"

#: ../libs/todoMenuItem.js:268 ../libs/todoMenuItem.js:479
msgid "Delete %(task)"
msgstr "Smazat %(task)"

#: ../libs/todoMenuItem.js:234
msgid "Edit %(task)"
msgstr "Editovat %(task)"

#: ../libs/todoTxtManager.js:811 ../libs/todoTxtManager.js:868
msgid "Error writing file"
msgstr "Chyba při zápisu souboru"

#: ../libs/todoMenuItem.js:287
msgid "Expand %(task)"
msgstr "Rozbalit %(task)"

#: ../libs/todoMenuItem.js:242
msgid "Increase %(task) priority"
msgstr "Zvýšit prioritu %(task)"

#: ../libs/todoMenuItem.js:300
msgid "Mark %(task) as done"
msgstr "Označit %(task) jako dokončený"

#: ../libs/newTaskEntry.js:16
msgid "New task…"
msgstr "Nová úloha…"

#: ../libs/todoTxtManager.js:544
msgid "No valid %(filename) file specified"
msgstr "Nebyl zadán žádný platný soubor %(filename)"

#: ../libs/messageDialog.js:39
msgid "Ok"
msgstr "Ok"

#: ../libs/openPreferencesEntry.js:12
msgid "Open preferences"
msgstr "Otevřít předvolby"

#: ../libs/todoTxtManager.js:517
msgid "Open settings"
msgstr "Otevřít nastavení"

#: ../libs/openTextEditorEntry.js:14
msgid "Open todo.txt file in text editor"
msgstr "Otevřít soubor todo.txt v textovém editoru"

#: ../libs/todoTxtManager.js:525
msgid "Please choose what you want to do"
msgstr "Vyberte prosím, co chcete dělat"

#: ../libs/todoTxtManager.js:545
msgid "Select location in settings"
msgstr "Vyberte umístění v nastavení"

#: ../libs/todoMenuItem.js:501
msgid "Undo delete %(task)"
msgstr "Vrátit zpět smazání %(task)"

#: ../libs/todoTxtManager.js:389
msgid "Ungrouped"
msgstr "Neseskupeno"

#: ../libs/todoTxtManager.js:820 ../libs/todoTxtManager.js:874
msgid "Unknown error during file write: %(error)"
msgstr "Neznámá chyba při zápisu souboru: %(error)"

#: ../libs/todoTxtManager.js:506
msgid "Use existing file"
msgstr "Použít existující soubor"

# settings.json
msgid "Action on clicking task"
msgstr "Akce při kliknutí na úkol"

# settings.json
msgid "Auto-add creation date to new tasks"
msgstr "Automaticky přidávat datum vytvoření k novým úkolům"

# settings.json
msgid "Auto-archive done tasks"
msgstr "Automaticky archivovat hotové úkoly"

# settings.json
msgid "Behavior"
msgstr "Chování"

# settings.json
msgid "Both"
msgstr "Oba"

# settings.json
msgid "Bottom of the file"
msgstr "Konec souboru"

# settings.json
msgid "Color for detected URLs"
msgstr "Barva pro zjištěné adresy URL"

# settings.json
msgid "Confirm task deletion"
msgstr "Potvrdit smazání úkolu"

# settings.json
msgid "Contexts"
msgstr "Kontexty"

# settings.json
msgid "Custom color"
msgstr "Vlastní barva"

# settings.json
msgid "Custom color for URLS"
msgstr "Vlastní barva pro adresy URL"

# settings.json
msgid "Debug"
msgstr "Ladit"

# settings.json
msgid "Debug level"
msgstr "Úroveň ladění"

# settings.json
msgid "Debugging"
msgstr "Ladění"

# settings.json
msgid "Dedicated button"
msgstr "Vyhrazené tlačítko"

# settings.json
msgid "Detail"
msgstr "Detail"

# settings.json
msgid "Display"
msgstr "Zobrazit"

# settings.json
msgid "Done.txt location"
msgstr "Umístění souboru Done.txt"

# settings.json
msgid "Due date extension"
msgstr "Termín dokončení"

# settings.json
msgid "Edit"
msgstr "Upravit"

# settings.json
msgid "End"
msgstr "Konec"

# settings.json
msgid "Error"
msgstr "Chyba"

# settings.json
msgid "Extensions"
msgstr "Rozšíření"

# settings.json
msgid "Files"
msgstr "Soubory"

# settings.json
msgid "Flow"
msgstr "Flow/"

# settings.json
msgid "General"
msgstr "Obecné"

# settings.json
msgid "Get color from theme"
msgstr "Získat barvu z motivu"

# settings.json
msgid "Group tasks by"
msgstr "Seskupit úkoly podle"

# settings.json
msgid "Grouping"
msgstr "Seskupování"

# settings.json
msgid "Hidden tasks extension"
msgstr "Skryté úkoly"

# settings.json
msgid "Hide if pattern is zero"
msgstr "Skrýt, pokud je schéma nulové"

# settings.json
msgid "Icon"
msgstr "Ikona"

# settings.json
msgid "If the due date extension is enabled, tasks containing 'due:<some date>' will be shown differently"
msgstr ""
"Pokud je povoleno rozšíření \"termín dokončení\", úkoly obsahující 'termín:"
"<nějaké datum>' se zobrazí jinak"

# settings.json
msgid "If the hidden extension is enabled, tasks containing 'h:1' will not be shown"
msgstr ""
"Pokud je \"skryté rozšíření\" povoleno, úkoly obsahující \"h:1\" se nezobrazí"

# settings.json
msgid "If the specified pattern is zero, the elements specified here will be hidden"
msgstr "Pokud je zadaný schéma nula, prvky zde uvedené budou skryté"

# settings.json
msgid "If this is true, an icon will be shown in the top bar"
msgstr "Pokud povoleno, v horní liště se zobrazí ikona"

# settings.json
msgid "If this template evaluates to zero, the top bar element will be hidden. Shortcuts still work."
msgstr ""
"Pokud je tato šablona nula, prvek horní lišty bude skrytý. Zkratky stále "
"fungují."

# settings.json
msgid "Info"
msgstr "Info"

# settings.json
msgid "Interface elements"
msgstr "Prvky rozhraní"

# settings.json
msgid "Keep as is (non-standard)"
msgstr "Ponechat tak, jak je (nestandardní)"

# settings.json
msgid "Keep open menu after adding new task"
msgstr "Po přidání nového úkolu nechat menu otevřené"

# settings.json
msgid "Keep with pri: prefix"
msgstr "Ponechat s pri: prefix"

# settings.json
msgid "Keeps open the tasks menu after a new task is added. The new task entry will be focused."
msgstr ""
"Po přidání nového úkolu ponechá otevřenou nabídku úkolů. Nový úkol bude "
"zvýrazněn."

# settings.json
msgid "Keyboard shortcut to open the task list"
msgstr "Klávesová zkratka pro otevření seznamu úkolů"

# settings.json
msgid "Level of debug information"
msgstr "Úroveň informací o ladění"

# settings.json
msgid "Location of the text file that contains completed (archived) tasks"
msgstr ""
"Umístění textového souboru, který obsahuje dokončené (archivované) úkoly"

# settings.json
msgid "Location of the text file that contains the tasks in todo.txt syntax"
msgstr "Umístění textového souboru, který obsahuje úkoly v syntaxi todo.txt"

# settings.json
msgid "Location to insert new task"
msgstr "Místo pro vložení nového úkolu"

# settings.json
msgid "Location to truncate long tasks"
msgstr "Místo pro zkrácení dlouhých úkolů"

# settings.json
msgid "Mark as done or archive"
msgstr "Označit jako hotové nebo archivovat"

# settings.json
msgid "Maximum task width in pixels"
msgstr "Maximální šířka úkolu v pixelech"

# settings.json
msgid "Method to expand/contract truncated tasks"
msgstr "Metoda rozbalováni/sbalování zkrácených úkolů"

# settings.json
msgid "Middle"
msgstr "Prostřední"

# settings.json
msgid "No grouping"
msgstr "Žádné seskupování"

# settings.json
msgid "Nothing"
msgstr "Nic"

# settings.json
msgid "Only show tasks with a given or higher priority. Leave empty to show all tasks."
msgstr ""
"Zobrazovat pouze úkoly s danou nebo vyšší prioritou. Chcete-li zobrazit "
"všechny úkoly, ponechte prázdné."

# settings.json
msgid "Only show tasks with a priority of or above"
msgstr "Zobrazovat pouze úkoly se stejnou nebo vyšší prioritou"

# settings.json
msgid "Open task list"
msgstr "Otevřít seznam úkolů"

# settings.json
msgid "Order elements by their priority"
msgstr "Seřaďte prvky podle priority"

# settings.json
msgid "Pattern to match for zero"
msgstr "Schéma, který bude odpovídat nule"

# settings.json
msgid "Priorities"
msgstr "Priority"

# settings.json
msgid "Priority markup"
msgstr "Prioritní označení"

# settings.json
msgid "Priority on task completion"
msgstr "Priorita dokončení úkolu"

# settings.json
msgid "Projects"
msgstr "Projekty"

# settings.json
msgid "Put ungrouped tasks in separate group"
msgstr "Neseskupené úkoly dát do samostatné skupiny"

# settings.json
msgid "Remove"
msgstr "Odstranit"

# settings.json
msgid "Same as task"
msgstr "Stejné jako úkol"

# settings.json
msgid "Scroll up/down"
msgstr "Posunovat nahoru/dolů"

# settings.json
msgid "Select location of done.txt file"
msgstr "Vyberte umístění souboru done.txt"

# settings.json
msgid "Select location of todo.txt file"
msgstr "Vyberte umístění souboru todo.txt"

# settings.json
msgid "Shortcuts"
msgstr "Zkratky"

# settings.json
msgid "Show 'open in text editor'"
msgstr "Zobrazit \"otevřít v textovém editoru\""

# settings.json
msgid "Show 'open preferences'"
msgstr "Zobrazit \"otevřít předvolby\""

# settings.json
msgid "Show change task priority buttons"
msgstr "Zobrazit tlačítka změny priority úkolu"

# settings.json
msgid "Show contexts"
msgstr "Zobrazit kontexty"

# settings.json
msgid "Show delete task button"
msgstr "Zobrazit tlačítko odstranění úkolu"

# settings.json
msgid "Show done tasks"
msgstr "Zobrazit hotové úkoly"

# settings.json
msgid "Show done/archive task button"
msgstr "Zobrazit tlačítko hotovo/archivovat"

# settings.json
msgid "Show edit task button"
msgstr "Zobrazit tlačítko upravit úkol"

# settings.json
msgid "Show icon"
msgstr "Zobrazit ikonu"

# settings.json
msgid "Show new task entry"
msgstr "Zobrazit nový úkol"

# settings.json
msgid "Show number of tasks in group"
msgstr "Zobrazit počet úkolů ve skupině"

# settings.json
msgid "Show projects"
msgstr "Zobrazit projekty"

# settings.json
msgid "Start"
msgstr "Start"

# settings.json
msgid "Style priorities"
msgstr "Styly priorit"

# settings.json
msgid "Styles"
msgstr "Styly"

# settings.json
msgid "Tasks can be grouped together based on the selected property"
msgstr "Úkoly lze seskupit podle vybrané vlastnosti"

# settings.json
msgid "Tasks that don't have the grouping priority can be put in a special 'ungrouped' group, or shown outside any groups"
msgstr ""
"Úkoly, které nemají prioritu seskupování, lze umístit do speciální "
"\"neseskupené\" skupiny nebo zobrazit mimo jakékoli skupiny"

# settings.json
msgid "Tasks will be truncated to this width (specified in pixels) if truncating is enabled."
msgstr ""
"Úlohy budou zkráceny na tuto šířku (zadanou v pixelech), pokud je zkrácení "
"povoleno."

# settings.json
msgid "Template string for display"
msgstr "Řetězec šablony pro zobrazení"

# settings.json
msgid "Template that determines what is displayed in the top bar"
msgstr "Šablona, která určuje, co se zobrazí v horní liště"

# settings.json
msgid "Text"
msgstr "Text"

# settings.json
msgid "The action that will initiate expansion and contraction of tasks"
msgstr "Akce, která vyvolá rozbalování a sbalování úkolů"

# settings.json
msgid "The location in the task text where the ellipsization will occur"
msgstr "Místo v textu úlohy, kde dojde k elipsizaci"

# settings.json
msgid "The number of tasks in a subgroup can be shown in the interface"
msgstr "Počet úkolů v podskupině lze zobrazit v rozhraní"

# settings.json
msgid "The way that tasks with different priorities are displayed"
msgstr "Způsob, jakým se zobrazují úkoly s různými prioritami"

# settings.json
msgid "This color will be used for URLs if 'Custom color' was selected above"
msgstr ""
"Tato barva bude použita pro adresy URL, pokud byla výše vybrána možnost "
"\"Vlastní barva\""

# settings.json
msgid "Todo.txt location"
msgstr "Umístění Todo.txt"

# settings.json
msgid "Top Bar"
msgstr "Horní lišta"

# settings.json
msgid "Top of the file"
msgstr "Začátek souboru"

# settings.json
msgid "Truncate long tasks"
msgstr "Zkrátit dlouhé úkoly"

# settings.json
msgid "Truncating"
msgstr "Zkracování"

# settings.json
msgid "URL Color"
msgstr "Barva URL"

# settings.json
msgid "Warning"
msgstr "Varování"

# settings.json
msgid "What should be done with the priority of a task when that task is completed"
msgstr "Co by se mělo udělat s prioritou úkolu, když je tento úkol dokončen"

# settings.json
msgid "What to do when a task is clicked"
msgstr "Co dělat po kliknutí na úkol"

# settings.json
msgid "When URLs are detected in a task, they will be displayed in this color"
msgstr "Když jsou v úloze zjištěny adresy URL, zobrazí se v této barvě"

# settings.json
msgid "Where in the text-file the new task will be added. Also moves insert box to the top of the interface."
msgstr ""
"Kde v textovém souboru bude přidán nový úkol. Také přesune vkládací pole do "
"horní části rozhraní."

# settings.json
msgid "Whether a button is shown to delete a task"
msgstr "Zda se zobrazí tlačítko pro odstranění úkolu"

# settings.json
msgid "Whether a button is shown to edit a task"
msgstr "Zda se zobrazí tlačítko pro úpravu úkolu"

# settings.json
msgid "Whether a button is shown to mark active tasks as completed or to archive completed tasks, if auto-archive is off."
msgstr ""
"Zda se zobrazí tlačítko pro označení aktivních úkolů jako dokončených nebo "
"pro archivaci dokončených úkolů, pokud je automatická archivace vypnutá."

# settings.json
msgid "Whether a confirmation dialog is shown before deleting a task"
msgstr "Zda se před odstraněním úlohy zobrazí potvrzovací dialog"

# settings.json
msgid "Whether a creation date is automatically added to newly created tasks"
msgstr "Zda se k nově vytvořeným úkolům automaticky přidá datum vytvoření"

# settings.json
msgid "Whether a menu element is shown to open the extension's preferences"
msgstr "Zda se zobrazí prvek nabídky pro otevření předvoleb rozšíření"

# settings.json
msgid "Whether a menu element is shown to open the todo.txt file in the default text editor"
msgstr ""
"Zda se zobrazí prvek nabídky pro otevření souboru todo.txt ve výchozím "
"textovém editoru"

# settings.json
msgid "Whether an entry field is shown to create new tasks (new tasks can also be added by modifying the todo.txt file)"
msgstr ""
"Zda se zobrazí vstupní pole pro vytvoření nových úkolů (nové úkoly lze také "
"přidat úpravou souboru todo.txt)"

# settings.json
msgid "Whether arrows are shown to increase or decrease the task priority"
msgstr "Zda se zobrazují šipky ke zvýšení nebo snížení priority úlohy"

# settings.json
msgid "Whether completed tasks that are not archived will be shown"
msgstr "Zda se zobrazí dokončené úkoly, které nejsou archivovány"

# settings.json
msgid "Whether completed tasks will be automatically archived (i.e. moved to the done.txt file)"
msgstr ""
"Zda budou dokončené úkoly automaticky archivovány (tj. přesunuty do souboru "
"done.txt)"

# settings.json
msgid "Whether contexts are shown in the interface (does not affect grouping)"
msgstr "Zda se kontexty zobrazují v rozhraní (neovlivňuje seskupování)"

# settings.json
msgid "Whether long tasks are truncated if they exceed a specified width"
msgstr "Zda jsou dlouhé úlohy zkráceny, pokud přesahují zadanou šířku"

# settings.json
msgid "Whether projects are shown in the interface (does not affect grouping)"
msgstr "Zda se projekty zobrazují v rozhraní (neovlivňuje seskupování)"

# settings.json
msgid "Whether tasks with a certain priority are shown in a specific style"
msgstr "Zda se úkoly s určitou prioritou zobrazují v určitém stylu"

# settings.json
msgid "Whether the tasks with a higher priority should be shown higher up in the list or the order should be left as in the todo.txt file"
msgstr ""
"Zda mají být úkoly s vyšší prioritou zobrazeny výše v seznamu nebo má být "
"pořadí ponecháno jako v souboru todo.txt"
