# settings.json
msgid "Whether a button is shown to edit a task"
msgstr "Si un bouton est montré pour l'édition des tâches"

# settings.json
#, fuzzy
msgid ""
"Whether a button is shown to mark active tasks as completed or to archive "
"completed tasks, if auto-archive is off."
msgstr ""
"Si un bouton est montré pour marquer les tâches actives comme accomplies, ou "
"pour archiver les tâches accomplies si l'auto-archivage est désactivé."

# settings.json
msgid "Whether a confirmation dialog is shown before deleting a task"
msgstr "Si une confirmation est demandée avant de supprimer une tâche"

# settings.json
msgid "Whether a creation date is automatically added to newly created tasks"
msgstr ""
"Si une date de création est automatiquement ajoutée aux tâches nouvellement "
"créées"

