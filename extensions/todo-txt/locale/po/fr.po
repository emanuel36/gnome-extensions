msgstr ""
"Si le contexte est affiché dans l'interface (n'affecte pas les groupements)"

# settings.json
msgid "Whether long tasks are truncated if they exceed a specified width"
msgstr ""
"Si les tâches longues sont tronquées quand elles excèdent une longueur "
"spécifiée"

