msgstr ""
"Si un élément du menu est montré pour ouvrir le fichier todo.txt dans "
"l'éditeur de texte par défaut"

# settings.json
msgid ""
"Whether a menu element is shown to open the todo.txt file in the default "
"text editor"
msgstr ""
"Si un élément du menu est montré pour ouvrir le fichier todo.txt dans "
"l'éditeur de texte par défaut"

# settings.json
msgid ""
"Whether an entry field is shown to create new tasks (new tasks can also be "
"added by modifying the todo.txt file)"
msgstr ""
"Si un champ d'entrée est montré pour créer de nouvelles tâches (de nouvelles "
"tâches peuvent être ajoutées par modification manuelle du fichier todo.txt)"

# settings.json
msgid "Whether arrows are shown to increase or decrease the task priority"
msgstr "Si les flèches pour augmenter/diminuer les priorités sont montrées"

# settings.json
#, fuzzy
msgid "Whether completed tasks that are not archived will be shown"
msgstr ""
"Si les tâches effectuées doivent être automatiquement archivées (c-à-d. "
"déplacées vers le fichier done.txt)"

# settings.json
msgid ""
"Whether completed tasks will be automatically archived (i.e. moved to the "
