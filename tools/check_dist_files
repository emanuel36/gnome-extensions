#!/bin/sh

TOOLS_DIR=$(dirname "$0")
dist_files="${TOOLS_DIR}/dist_files.lst"
git_files=$(mktemp)
git ls-files --exclude-standard --recurse-submodules -- \
    ':!**/.*' \
    ':!tools/*' \
    ':!tests/*' \
    ':!docker/*' \
    ':!eslint.config.mjs' \
    ':!requirements.txt' \
    ':!preferences/ui/*Widget.xml' \
    ':!preferences/createPrefsTemplate.py' \
    ':!.pre-commit-config.yaml' \
    ':!package*.json' \
    ':!**/*/package*.json' \
    ':!Makefile' \
    ':!locale/po/*' \
    ':!locale/*.sh' \
    ':!locale/messages.pot' \
    ':!locale/extract_settings.py' \
    ':!.jshintrc' \
    ':!.git*' \
    ':!images/*' \
    ':!third_party/**/README.md' \
    ':!third_party/**/test/*' \
    ':!third_party/**/*.html' \
    ':!third_party/**/jasmine.json' \
    ':!third_party/**/Makefile' \
    ':!third_party/**/spec/*' \
    ':!third_party/**/requirements.txt' \
    ':!third_party/**/examples/*' \
    ':!third_party/**/webpack.config.js' \
    | sort > "${git_files}"

in_repo_not_in_distfiles() {
    file=$(echo "$1" | cut -d '+' -f 2-)
    printf "%s is in repo, but not in dist_files.lst. Add? (Y/n)\n" "$file"
    read -r answer < /dev/tty
    case "$answer" in
        "n") return ;;
        *)
            echo "$file" >> "$dist_files"
            sort "$dist_files" | sponge "$dist_files"
            ;;
    esac
}

in_distfiles_not_in_repo() {
    file=$(echo "$1" | cut -d '-' -f 2-)
    printf "%s is in dist_files.lst, but not in the repo. Remove? (Y/n)\n" "$file"
    read -r answer < /dev/tty
    case "$answer" in
        "n") exit 0 ;;
        *)
            grep -v "^$file$" "$dist_files" | sponge "$dist_files"
            ;;
    esac
}

diff -u "$dist_files" "${git_files}" | grep "^[+-][^+-]" | grep -v "^-schemas/" | while read -r diff_line; do
    case "$diff_line" in
        +*) in_repo_not_in_distfiles "$diff_line" ;;
        -*) in_distfiles_not_in_repo "$diff_line" ;;
        *) echo "Invalid line: $diff_line";;
    esac
done

rm -f "${git_files}"
